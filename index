<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ATM Logistics - Farm Sim RP Dashboard</title>
  <style>
    :root {
      --bg-dark: #0f172a;
      --bg-card: #1e293b;
      --bg-hover: #334155;
      --accent: #38bdf8;
      --accent-green: #22c55e;
      --accent-red: #ef4444;
      --accent-amber: #f59e0b;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: var(--bg-dark); color: var(--text); padding: 20px; }

    header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
    .logo { font-size: 1.5rem; font-weight: bold; color: var(--accent); }
    .logo span { color: var(--text); }
    .user-badge { background: var(--bg-card); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); font-size: 0.9rem; }

    /* AUTH MODAL */
    #authOverlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.95); display: flex; justify-content: center; align-items: center; z-index: 999; }
    .auth-card { background: var(--bg-card); border: 1px solid var(--border); padding: 30px; border-radius: 12px; width: 100%; max-width: 400px; text-align: center; }
    .auth-card h2 { color: var(--accent); margin-bottom: 15px; }

    .nav { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .nav-btn { background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border); padding: 10px 18px; border-radius: 6px; cursor: pointer; font-weight: 600; transition: all 0.2s; }
    .nav-btn:hover, .nav-btn.active { background: var(--accent); color: var(--bg-dark); border-color: var(--accent); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 20px; }
    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
    .card h3 { color: var(--accent); margin-bottom: 15px; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 8px; }

    .stat-val { font-size: 1.8rem; font-weight: bold; margin-top: 5px; }
    .stat-val.green { color: var(--accent-green); }

    form { display: flex; flex-direction: column; gap: 12px; }
    input, select, button { padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-dark); color: var(--text); outline: none; }
    button.btn-primary { background: var(--accent); color: var(--bg-dark); font-weight: bold; cursor: pointer; border: none; transition: 0.2s; }
    button.btn-primary:hover { opacity: 0.9; }

    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    th { color: var(--text-muted); background: rgba(0,0,0,0.2); }
    tr:hover { background: var(--bg-hover); }

    .badge { padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; display: inline-block; }
    .badge-open { background: var(--accent-amber); color: #000; }
    .badge-progress { background: var(--accent); color: #000; }
    .badge-completed { background: var(--accent-green); color: #000; }
    .badge-danger { background: var(--accent-red); color: #fff; }

    .btn-sm { padding: 4px 8px; font-size: 0.8rem; cursor: pointer; border-radius: 4px; border: none; background: var(--accent-green); color: #000; font-weight: bold; }
  </style>
</head>
<body>

  <!-- LOGIN / PROFILE MODAL -->
  <div id="authOverlay">
    <div class="auth-card">
      <h2>Driver & Operator Login</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">Select your profile to auto-fill scale tickets and dispatch forms.</p>
      <form onsubmit="handleLogin(event)">
        <input type="text" id="loginName" placeholder="Player / Driver Name" required>
        <select id="loginRole" required>
          <option value="">Select Primary Role</option>
          <option value="Logistics">Logistics / Driver</option>
          <option value="Farming">Farm Operator</option>
          <option value="Logging">Logging Specialist</option>
        </select>
        <input type="text" id="loginRig" placeholder="Default Rig ID (e.g. Kenworth #104)" required>
        <button type="submit" class="btn-primary">Enter Dashboard</button>
      </form>
    </div>
  </div>

  <header>
    <div class="logo">AT THE MILE <span>LOGISTICS & RP DASHBOARD</span></div>
    <div class="user-badge">
      Logged in as: <strong id="currentUserDisplay" style="color: var(--accent);">Guest</strong> 
      <button onclick="logout()" style="margin-left: 8px; padding: 2px 6px; font-size: 0.75rem; cursor: pointer;">Switch</button>
    </div>
  </header>

  <div class="nav">
    <button class="nav-btn active" onclick="switchTab('dispatch')">🚛 Freight & Dispatches</button>
    <button class="nav-btn" onclick="switchTab('bank')">🏦 Central Bank & Ledger</button>
    <button class="nav-btn" onclick="switchTab('fleet')">⚖️ Weigh-In & Safety</button>
  </div>

  <!-- TAB 1: DISPATCH BOARD -->
  <div id="dispatch" class="tab-content active">
    <div class="grid">
      <div class="card">
        <h3>Post New Freight Job</h3>
        <form id="jobForm" onsubmit="createJob(event)">
          <input type="text" id="jobTitle" placeholder="Cargo Description (e.g., 100k L Wheat)" required>
          <select id="jobSector" required>
            <option value="Farming">Farming Division</option>
            <option value="Logging">Logging Ops</option>
            <option value="Logistics">Logistics Hub</option>
          </select>
          <input type="text" id="jobPickup" placeholder="Pickup Location" required>
          <input type="text" id="jobDropoff" placeholder="Dropoff Location" required>
          <input type="number" id="jobPayout" placeholder="Payout ($)" required>
          <button type="submit" class="btn-primary">Post Freight Job</button>
        </form>
      </div>
      <div class="card" style="grid-column: span 2;">
        <h3>Active Freight Board</h3>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Cargo</th>
              <th>Sector</th>
              <th>Route</th>
              <th>Payout</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="dispatchTable"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- TAB 2: BANKING & LEDGER -->
  <div id="bank" class="tab-content">
    <div class="grid">
      <div class="card">
        <h3>Company Balances</h3>
        <div>
          <div>ATM Central Bank: <span class="stat-val green" id="bankCentral">$150,000</span></div><br>
          <div>Farming Sector Fund: <span class="stat-val" id="bankFarming">$45,000</span></div><br>
          <div>Logging Sector Fund: <span class="stat-val" id="bankLogging">$62,000</span></div>
        </div>
      </div>
      <div class="card">
        <h3>Execute Transfer</h3>
        <form id="bankForm" onsubmit="processTransaction(event)">
          <select id="transFrom" required>
            <option value="Central">ATM Central Bank</option>
            <option value="Farming">Farming Sector</option>
            <option value="Logging">Logging Sector</option>
          </select>
          <select id="transTo" required>
            <option value="Farming">Farming Sector</option>
            <option value="Logging">Logging Sector</option>
            <option value="Central">ATM Central Bank</option>
          </select>
          <input type="number" id="transAmount" placeholder="Amount ($)" required>
          <input type="text" id="transMemo" placeholder="Memo (e.g., Lease Fee)" required>
          <button type="submit" class="btn-primary">Execute Transaction</button>
        </form>
      </div>
    </div>
  </div>

  <!-- TAB 3: WEIGH-IN & SAFETY -->
  <div id="fleet" class="tab-content">
    <div class="grid">
      <div class="card">
        <h3>Scale House Log</h3>
        <form id="scaleForm" onsubmit="logScale(event)">
          <input type="text" id="scaleDriver" placeholder="Driver Name" required readonly style="opacity: 0.7;">
          <input type="text" id="scaleVehicle" placeholder="Truck / Rig ID" required readonly style="opacity: 0.7;">
          <input type="number" id="scaleWeight" placeholder="Gross Weight (Tons)" required>
          <input type="number" id="scaleLimit" placeholder="Max Legal Weight (Tons)" value="42" required>
          <button type="submit" class="btn-primary">Submit Scale Weight</button>
        </form>
      </div>
      <div class="card" style="grid-column: span 2;">
        <h3>Recent Weigh-In Records</h3>
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Driver</th>
              <th>Rig ID</th>
              <th>Weight</th>
              <th>Limit</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="scaleTable"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    let currentUser = JSON.parse(localStorage.getItem('atm_user')) || null;

    let jobs = JSON.parse(localStorage.getItem('atm_jobs')) || [
      { id: 101, title: '80k L Wheat to Mill', sector: 'Farming', pickup: 'Silo 2', dropoff: 'Grain Mill', payout: 3500, status: 'Open' },
      { id: 102, title: '3 Loaders Long Oak Logs', sector: 'Logging', pickup: 'Cougar Rock Site', dropoff: 'Sawmill', payout: 5200, status: 'Open' }
    ];

    let balances = JSON.parse(localStorage.getItem('atm_balances')) || { Central: 150000, Farming: 45000, Logging: 62000 };
    let ledger = JSON.parse(localStorage.getItem('atm_ledger')) || [];
    let scaleLogs = JSON.parse(localStorage.getItem('atm_scale')) || [];

    function checkAuth() {
      if (!currentUser) {
        document.getElementById('authOverlay').style.display = 'flex';
      } else {
        document.getElementById('authOverlay').style.display = 'none';
        document.getElementById('currentUserDisplay').innerText = `${currentUser.name} (${currentUser.role})`;
        
        // AUTOFILL FORMS
        document.getElementById('scaleDriver').value = currentUser.name;
        document.getElementById('scaleVehicle').value = currentUser.rig;
        document.getElementById('jobSector').value = currentUser.role !== 'Driver' ? currentUser.role : 'Farming';
      }
    }

    function handleLogin(e) {
      e.preventDefault();
      currentUser = {
        name: document.getElementById('loginName').value,
        role: document.getElementById('loginRole').value,
        rig: document.getElementById('loginRig').value
      };
      localStorage.setItem('atm_user', JSON.stringify(currentUser));
      checkAuth();
    }

    function logout() {
      localStorage.removeItem('atm_user');
      currentUser = null;
      checkAuth();
    }

    function saveData() {
      localStorage.setItem('atm_jobs', JSON.stringify(jobs));
      localStorage.setItem('atm_balances', JSON.stringify(balances));
      localStorage.setItem('atm_scale', JSON.stringify(scaleLogs));
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      event.target.classList.add('active');
    }

    function renderJobs() {
      const tbody = document.getElementById('dispatchTable');
      tbody.innerHTML = '';
      jobs.forEach(job => {
        let badgeClass = job.status === 'Open' ? 'badge-open' : job.status === 'In Transit' ? 'badge-progress' : 'badge-completed';
        let actionBtn = job.status === 'Open' 
          ? `<button class="btn-sm" onclick="claimJob(${job.id})">Claim</button>`
          : job.status === 'In Transit'
          ? `<button class="btn-sm" onclick="completeJob(${job.id})">Complete</button>`
          : '—';

        tbody.innerHTML += `
          <tr>
            <td>#${job.id}</td>
            <td><strong>${job.title}</strong></td>
            <td>${job.sector}</td>
            <td>${job.pickup} ➔ ${job.dropoff}</td>
            <td>$${job.payout.toLocaleString()}</td>
            <td><span class="badge ${badgeClass}">${job.status}</span></td>
            <td>${actionBtn}</td>
          </tr>
        `;
      });
    }

    function createJob(e) {
      e.preventDefault();
      jobs.push({
        id: Math.floor(100 + Math.random() * 900),
        title: document.getElementById('jobTitle').value,
        sector: document.getElementById('jobSector').value,
        pickup: document.getElementById('jobPickup').value,
        dropoff: document.getElementById('jobDropoff').value,
        payout: parseFloat(document.getElementById('jobPayout').value),
        status: 'Open'
      });
      saveData();
      renderJobs();
      document.getElementById('jobForm').reset();
    }

    function claimJob(id) {
      const job = jobs.find(j => j.id === id);
      if (job) { job.status = 'In Transit'; saveData(); renderJobs(); }
    }

    function completeJob(id) {
      const job = jobs.find(j => j.id === id);
      if (job) {
        job.status = 'Completed';
        balances.Central -= job.payout;
        balances[job.sector] += job.payout;
        saveData();
        renderJobs();
        renderBank();
      }
    }

    function renderBank() {
      document.getElementById('bankCentral').innerText = `$${balances.Central.toLocaleString()}`;
      document.getElementById('bankFarming').innerText = `$${balances.Farming.toLocaleString()}`;
      document.getElementById('bankLogging').innerText = `$${balances.Logging.toLocaleString()}`;
    }

    function logScale(e) {
      e.preventDefault();
      scaleLogs.unshift({
        time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
        driver: document.getElementById('scaleDriver').value,
        vehicle: document.getElementById('scaleVehicle').value,
        weight: parseFloat(document.getElementById('scaleWeight').value),
        limit: parseFloat(document.getElementById('scaleLimit').value)
      });
      saveData();
      renderScale();
      document.getElementById('scaleWeight').value = '';
    }

    function renderScale() {
      const tbody = document.getElementById('scaleTable');
      tbody.innerHTML = '';
      scaleLogs.forEach(log => {
        let isOver = log.weight > log.limit;
        let badge = isOver ? `<span class="badge badge-danger">OVERWEIGHT</span>` : `<span class="badge badge-completed">LEGAL</span>`;
        tbody.innerHTML += `
          <tr>
            <td>${log.time}</td>
            <td>${log.driver}</td>
            <td>${log.vehicle}</td>
            <td>${log.weight} T</td>
            <td>${log.limit} T</td>
            <td>${badge}</td>
          </tr>
        `;
      });
    }

    checkAuth();
    renderJobs();
    renderBank();
    renderScale();
  </script>
</body>
</html>
